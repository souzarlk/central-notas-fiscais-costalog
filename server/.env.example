# Neon / PostgreSQL
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/DB?sslmode=require
PORT=3000

# SEFAZ: preencher somente no ambiente seguro do Render.
# O NOVO certificado A1 deve ser enviado como Secret File, nunca ao GitHub.
SEFAZ_ENABLED=false
SEFAZ_CERT_PATH=/etc/secrets/costalog-certificado.pfx
SEFAZ_CERT_PASSWORD=CONFIGURAR_SOMENTE_NO_RENDER
SEFAZ_CNPJ=CONFIGURAR_NO_RENDER
SEFAZ_CUFAUTOR=35
SEFAZ_TP_AMB=1
SEFAZ_DISTRIBUTION_URL=https://www1.nfe.fazenda.gov.br/NFeDistribuicaoDFe/NFeDistribuicaoDFe.asmx

# Gerar token aleatório longo e cadastrar no Render e em GitHub Actions Secrets.
COSTALOG_SYNC_TOKEN=GERAR_TOKEN_SEGURO
